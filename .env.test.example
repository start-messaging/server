# Template for `.env.e2e` — the local end-to-end environment.
#
# Kept separate from `.env.example` on purpose: that file is the template for a
# real deployment, and mixing mock seams into it invites someone to copy a
# test switch into production. Nothing here belongs on a server.
#
# `playwright.config.ts` loads `.env.e2e` if it exists and falls back to the
# tracked `.env.ci` otherwise, so a fresh clone runs the suite without this
# file. Copy it to `.env.e2e` only when you need to diverge locally.
#
# The secrets below are placeholders, not credentials — enough to boot a test
# environment and nothing more. For the ones that must match a real test
# account (GOOGLE_CLIENT_ID, RAZORPAY_*, the R2 keys), copy them from `.env.ci`,
# which is tracked and holds test-account values.
#
# The suites share one database and cannot run concurrently — each takes a
# Postgres advisory lock in its globalSetup and refuses to start while another
# holds it.


# Identity of the environment
NODE_ENV=test

# Required-by-Joi placeholders. PARTNER_JWT_SECRET must differ from JWT_SECRET
# — config validation rejects them being equal, so a token minted for the
# customer app can never be replayed against the partner portal.
DATABASE_PASSWORD=postgres
JWT_SECRET=e2e-jwt-secret-not-a-real-key
PARTNER_JWT_SECRET=e2e-partner-jwt-secret-not-a-real-key

# Database and Redis — sm_test, never sm_db
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=sm_test
DATABASE_USERNAME=postgres
REDIS_URL=redis://127.0.0.1:6379/14
# Namespaces BullMQ, the rate limiter and the shared client. Empty in
# production; set here so a test worker can never pull a real job off the
# `messages` queue — the queue that spends money.
REDIS_KEY_PREFIX=e2e

# Available but not used by the suite: the `mock` provider reports delivery
# without sending. The suite drives the console provider instead.
# MOCK_SMS_SEND=true

# Test-only seams. Every one of these is ALSO gated on NODE_ENV=test in code,
# so a stray true in a real environment still does nothing
GOOGLE_MOCK_VERIFY=true
PAYMENTS_FAKE_GATEWAY=true
SMS_CONSOLE_PROVIDER=true
OUTREACH_CONSOLE_PROVIDER=true

# Background sweeps, off so nothing fires mid-assertion
SMS_RECONCILE_ENABLED=false
AFFILIATE_SCHEDULER_ENABLED=false

# Fixture servers the suite starts on these ports
LEADS_NRD_URL_TEMPLATE=http://127.0.0.1:41100/nrd/{date}.txt
LEADS_ENRICH_URL_TEMPLATE=http://127.0.0.1:41100/site/{domain}
OUTREACH_PUBLIC_BASE_URL=http://127.0.0.1:3010
R2_ENDPOINT=http://127.0.0.1:41101
R2_PUBLIC_URL=http://127.0.0.1:41101/public
R2_BUCKET_NAME=e2e-kyc-bucket

# Turned down so the suite runs fast
BCRYPT_ROUNDS=4
JWT_EXPIRATION=15m
OUTREACH_DAILY_CAP=5
PORT=3010

# Browser tier — the suite installs Chromium, so the empty channel is right
LEADS_BROWSER_ENRICH_ENABLED=true
LEADS_BROWSER_CHANNEL=
