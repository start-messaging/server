PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=startmessaging
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Affiliate partner portal JWT. Partners are a separate identity from customers
# and get their own token. Set a DISTINCT secret in production; if left empty it
# falls back to JWT_SECRET (the `typ` claim still keeps the two audiences apart,
# but a separate secret is the stronger boundary).
PARTNER_JWT_SECRET=
PARTNER_JWT_EXPIRATION=1h

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# SMS transport: 'console' (dev — logs the OTP to the server console) or
# 'twofactor' (real gateway). Use 'twofactor' in production.
SMS_DRIVER=console

# Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=dlt
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_TEMPLATE_ID=

# 2Factor.in
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=OTP1

# OTP Settings
# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Payment convenience fee (customer-fee-bearer): the user pays Razorpay's
# platform fee + GST on top of their top-up; only the base is credited.
RAZORPAY_FEE_PERCENT=2
RAZORPAY_GST_PERCENT=18
PAYMENT_FEE_BEARER=customer

# Affiliate / referral program
AFFILIATE_COMMISSION_PERCENT=10
AFFILIATE_MIN_PAID_USERS=10
AFFILIATE_MIN_WITHDRAWAL=1000
AFFILIATE_PAYOUT_START_DAY=21
AFFILIATE_PAYOUT_END_DAY=28

# OTP
OTP_EXPIRY_MINUTES=5
OTP_COST=0.25

# Redis
REDIS_URL=redis://localhost:6379

# Email transport: 'console' (dev — logs the email) or 'mailgun' (real).
# Falls back to console automatically if Mailgun is unconfigured.
MAIL_DRIVER=console

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_NAME=StartMessaging
MAILGUN_FROM_EMAIL=

# Custom Testing
MOCK_SMS_SEND=false

# PostHog Logging (OpenTelemetry)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

