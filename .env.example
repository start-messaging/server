PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=startmessaging
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=dlt
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_TEMPLATE_ID=

# 2Factor.in
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=OTP1

# OTP Settings
# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Convenience fee ────────────────────────────────────
# Passes the gateway's cut on to the customer instead of absorbing it.
#
# OFF by default. Turning it on changes what every customer is charged, so it
# must be a deliberate act rather than something that arrives with a deploy.
#
# The charge is grossed up, not marked up: the gateway takes its percentage of
# the total it processes, including the surcharge, so charging amount + 2.36%
# still leaves you short. `amount / (1 - rate)` is what actually nets the
# top-up. On a 1,000 top-up at 2% + 18% GST the customer pays 1,024.17.
#
# CAUTION: UPI carries zero MDR in India and merchants are not permitted to
# levy a charge on it. The payment method is not known when the order is
# created — the customer chooses it afterwards inside Razorpay Checkout — so a
# fee configured here applies to UPI payments as well. Razorpay's own
# Customer Fee Bearer feature avoids this by charging per method at checkout,
# but it requires Razorpay Optimizer and is enabled by your account manager.
CONVENIENCE_FEE_ENABLED=false
CONVENIENCE_FEE_PERCENT=2
CONVENIENCE_FEE_GST_PERCENT=18

# OTP
OTP_EXPIRY_MINUTES=5
OTP_COST=0.25

# Redis
REDIS_URL=redis://localhost:6379

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_NAME=StartMessaging
MAILGUN_FROM_EMAIL=
  
# Custom Testing
MOCK_SMS_SEND=false

# Logs SMS to the server console instead of sending, so mobile verification and
# OTP flows work locally without real 2Factor credentials. It is the lowest
# priority provider, so a configured real provider always wins.
# Local development only — in production this would make sends silently succeed
# without reaching anyone.
SMS_CONSOLE_PROVIDER=false

# PostHog Logging (OpenTelemetry)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com


# Affiliate partner portal. MUST be a different value from JWT_SECRET — config
# validation rejects a match, because sharing one would let a customer token
# authenticate partner routes.
PARTNER_JWT_SECRET=
PARTNER_JWT_EXPIRATION=1h

# Where a partner's referral link points: the CUSTOMER dashboard signup page,
# not the partner portal. A referral link is followed by a prospective
# customer — pointing it at the portal lands them on a partner login screen,
# so the click never becomes a signup and the partner never earns anything.
AFFILIATE_REFERRAL_BASE_URL=https://app.startmessaging.com
