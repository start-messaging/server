
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=startmessaging
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1h

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
# Cloudflare R2 (KYC document storage)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Optional: any S3-compatible endpoint (minio, localstack, a test fixture).
# Unset = Cloudflare R2, derived from R2_ACCOUNT_ID.
R2_ENDPOINT=

# Fast2SMS

# 2Factor.in
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=OTP1
TWOFACTOR_SENDER_ID=STMSG

# OTP Settings
# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Convenience fee ────────────────────────────────────
# The customer pays the gateway's cut. This is always on — it is part of what a
# top-up costs, not something a deployment switches. Setting none of these is
# already correct; they exist only so the rate can follow the gateway's pricing
# without a code change.
#
#   MODE=simple    (default) adds PERCENT to the top-up. 1,000 at 2% -> fee
#                  20.00, customer pays 1,020.00. Round numbers, easy to put on
#                  a receipt. It does not recover the cost in full: the gateway
#                  takes its cut of the 1,020 it processes, not of the 1,000
#                  credited, and charges GST on that cut — leaving roughly 4
#                  short per 1,000. Set PERCENT=2.36 to cover the tax.
#
#   MODE=gross_up  charges whatever nets the top-up exactly, using PERCENT and
#                  GST_PERCENT: 1,000 at 2% + 18% GST -> pays 1,024.17.
#
# CAUTION: UPI carries zero MDR in India and merchants are not permitted to
# levy a charge on it. The payment method is not known when the order is
# created — the customer chooses it afterwards inside Razorpay Checkout — so
# this fee applies to UPI payments too. Razorpay's own Customer Fee Bearer
# feature charges per method at checkout instead, but it requires Razorpay
# Optimizer and is enabled by your account manager.
CONVENIENCE_FEE_MODE=simple
CONVENIENCE_FEE_PERCENT=2
CONVENIENCE_FEE_GST_PERCENT=18

# OTP

# Redis
#
# The optional /N path picks the logical DB, and every user of this URL now
# honours it: BullMQ's queues, the throttler's counters and the shared ioredis
# client alike. Changing the path relocates every queue — jobs already enqueued
# on the old DB stay there with no worker left to drain them. No path means
# db 0. A malformed path (/db14, /abc) is rejected at boot instead of silently
# resolving to db 0, which is the shared keyspace queues must stay out of.
REDIS_URL=redis://localhost:6379
# Namespaces every Redis key this instance writes, BullMQ's queue prefix
# included (`<prefix>:bull:*`). EMPTY IN PRODUCTION, so its keys keep the names
# they already have and in-flight jobs are still found after a deploy.
# Everywhere else it is the isolation floor: without it a test run and a
# developer's API share the bare `bull:*` keyspace on one machine and the two
# sets of workers drain each other's queues. Letters, digits, dashes and
# underscores only — a colon is the separator and would nest unpredictably.
REDIS_KEY_PREFIX=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_NAME=StartMessaging
MAILGUN_FROM_EMAIL=

# Onboarding reminders
#
# Two nudges to accounts that signed up and never finished: one at 24-48 hours,
# a last one at 7-8 days. Both go out on the Mailgun credentials above, because
# this is account mail rather than outreach.
#
# Off by default, and it has to be switched on per environment — leave it unset
# anywhere pointed at the production database that is not production itself.
# Turn DRY_RUN on first: it writes the rows and logs every intended recipient
# without sending, which is how to see who the first real run would hit.
ONBOARDING_REMINDERS_ENABLED=false
ONBOARDING_REMINDERS_DRY_RUN=false
# The per-run ceiling is not an env var: it is a safety backstop, not a
# deployment setting, and lives in
# src/onboarding/constants/onboarding-reminders.constant.ts.

# Logs SMS to the server console instead of sending, so mobile verification and
# OTP flows work locally without real 2Factor credentials. It is the lowest
# priority provider, so a configured real provider always wins.
# Local development only — in production this would make sends silently succeed
# without reaching anyone.
SMS_CONSOLE_PROVIDER=false

# Status reconcile sweep
#
# Settles messages no provider webhook ever arrived for. On unless this is
# exactly `false` — an environment that has never heard of the flag runs it,
# which is what a real deployment needs the default to be. Test environments
# switch it off: the sweep wakes mid-run and rewrites message rows between a
# seed and the assertion against it.
SMS_RECONCILE_ENABLED=true
# Its cadence, grace window, max age and batch size (SMS_RECONCILE_*) are
# validated but not listed: the defaults — every 5 min, 10 min grace, 48 h
# ceiling, 50 rows — are what every deployment runs. See validation.ts.

# PostHog Logging (OpenTelemetry)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com


# Affiliate partner portal. MUST be a different value from JWT_SECRET — config
# validation rejects a match, because sharing one would let a customer token
# authenticate partner routes.
PARTNER_JWT_SECRET=
PARTNER_JWT_EXPIRATION=1h

# Where a partner's referral link points: the CUSTOMER dashboard signup page,
# not the partner portal. A referral link is followed by a prospective
# customer — pointing it at the portal lands them on a partner login screen,
# so the click never becomes a signup and the partner never earns anything.
AFFILIATE_REFERRAL_BASE_URL=https://app.startmessaging.com
# Whether this process registers the affiliate accrual/payout timers.
# Defaults on; the e2e suite sets it false so a background accrual
# cannot fire mid-test. Declared in Joi as of the env audit — it used to
# be a raw `!== 'false'` read, which treated FALSE/0/no as ON.
AFFILIATE_SCHEDULER_ENABLED=true

# ── Leads & cold outreach ──
#
# A customer-acquisition pipeline in three env-gated stages. An environment
# that sets none of these behaves exactly as before: the code is inert and
# the tables stay empty.

# Stage 1: daily ingest of newly-registered domains from the free WhoisDS
# list. There is deliberately no LEADS_INGEST_ENABLED here: the auto-run gate
# is operated from the admin panel (lead_pipeline_settings.ingestEnabled) and
# nowhere else. It is off until switched on there, so a fresh deployment never
# starts crawling on boot. The other *_ENABLED gates below are still env
# DEFAULTS that the panel's runtime settings override live.
# {dateBase64Zip} expands to base64("YYYY-MM-DD.zip") — WhoisDS's URL scheme.
# {date} is the bare date. Override for tests or a future mirror.
LEADS_NRD_URL_TEMPLATE=https://www.whoisds.com/whois-database/newly-registered-domains/{dateBase64Zip}/nrd
# The curated lists — Indian TLDs, generic TLDs, blocked foreign ccTLDs,
# keywords and India tokens — are NOT env vars. They are data, not deployment
# config: no environment ever wanted a different answer to "is .de an Indian
# prospect". They live in src/leads/nrd/tld-lists.constant.ts, where review
# sees them and the filter's own spec imports the same values it tests.
# Backstop against a poisoned or mis-parsed file flooding the leads table —
# not a curation tool: the ingest priority-sorts (India first, score desc)
# before cutting, so a cap cut only discards the low-value tail. With
# ingest-all, ~100-150k generic keeps/day is the new normal; 200k fits a
# healthy day whole.
# Backfill knobs (POST /admin/leads/ingest/run, not env): `days` (1-10)
# enqueues one run per day walking back from `date`; `url` overrides the
# source for one run with an allowlisted mirror (whoisds.com / dl.cenk.app).
# Honest caveat: older free files are truncated to ~70k domains, so backfills
# are samples; only the daily run sees the full file.

# Stage 1b: the liveness prober — tags every lead live/inactive (one DNS
# answer + one headerless GET, ~25 concurrent) so the enrichment crawler
# only ever spends its 10s timeouts on sites that answer. Inactive leads are
# re-probed on an age backoff (daily for the first 14 days after
# registration, weekly to day 90, monthly after) — a domain that is not live
# today is a business that has not launched yet, never a dead end. Hourly
# sweeps; batch × 24 must exceed the daily intake plus due re-probes.
# The liveness prober has no env vars. Its auto-run gate is operated from the
# admin panel (lead_pipeline_settings.livenessEnabled) and is off until switched
# on there; its batch size, probe concurrency and timeout are in
# src/leads/liveness/liveness-tuning.constant.ts, because they describe how a
# DNS answer behaves rather than where this deployment points.

# Stage 2: the enrichment DRAIN — claims and crawls slice after slice until
# nothing is eligible (pending + probed live + not delisted), then stops; a
# 5-minute kick starts a new drain when fresh work appears. Crawled leads
# re-enter after LEADS_ENRICH_RECRAWL_HOURS (sites change, contacts appear).
# NOTE: ENABLED / BATCH / CONCURRENCY / RECRAWL_HOURS are only the DEFAULTS —
# the admin panel's runtime settings (lead_pipeline_settings) override them
# without a redeploy.
LEADS_ENRICH_ENABLED=false
LEADS_ENRICH_BATCH_PER_SWEEP=500
LEADS_ENRICH_CONCURRENCY=4
LEADS_ENRICH_RECRAWL_HOURS=48
# Per-run safety valve, deliberately env-only: one drain can never exceed
# this many crawls, whatever the panel sets.
# Test seam — fixtures replace the scheme+host, not the code.
LEADS_ENRICH_URL_TEMPLATE=https://{domain}
# Parking-service nameserver suffixes: a lead whose NS ends with one of these
# is marked parked WITHOUT fetching its page — DNS is cheaper and harder to
# fool than HTML (Hostinger's parking is literally ns1.dns-parking.com).
# Parked leads are rechecked by the sweep every LEADS_PARKED_RECHECK_DAYS:
# a parked domain is a business that bought its name and hasn't launched.

# Stage 2b: the headless-browser escalation tier — re-renders sites the
# fetch+regex tier found no contacts on, because Wix/Shopify/React shells
# only grow their contact links after JavaScript runs. OFF by default and
# NOT for the production API box: a headless Chromium on a 2GB host would
# starve the API. Run it from a laptop/VPS worker pointed at the same
# database and Redis.
LEADS_BROWSER_ENRICH_ENABLED=false
# 'chrome' = the machine's installed Google Chrome (playwright-core downloads
# nothing). Empty = the playwright registry Chromium, present wherever
# `npx playwright install chromium` has run (dev machines, CI).
LEADS_BROWSER_CHANNEL=chrome
# Absolute path to a browser binary; wins over LEADS_BROWSER_CHANNEL.
LEADS_BROWSER_EXECUTABLE_PATH=
# One page at a time — this tier trades speed for reach.

# Stage 3: the cold-outreach sender. These SMTP credentials MUST be a
# SEPARATE lookalike domain's inbox, never the product Mailgun account —
# every mainstream ESP's AUP prohibits unsolicited outreach, and one
# complaint spike would suspend the account every password-reset depends on.
# Unset = outreach endpoints answer 503 OUTREACH_NOT_CONFIGURED.
OUTREACH_SMTP_HOST=
OUTREACH_SMTP_PORT=587
OUTREACH_SMTP_USER=
OUTREACH_SMTP_PASS=
OUTREACH_SMTP_SECURE=false
OUTREACH_FROM_NAME=StartMessaging
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=
# Log outreach mail instead of sending it. Local development and tests only.
OUTREACH_CONSOLE_PROVIDER=false
# Deliverability protection for the outreach domain: a new domain that
# suddenly sends hundreds/day gets junk-foldered for good. Counted in
# Asia/Kolkata days. Raise it only alongside gradual domain warmup.
OUTREACH_DAILY_CAP=100
# Where the tracking pixel/click/unsubscribe URLs point — this API.
OUTREACH_PUBLIC_BASE_URL=https://api.startmessaging.com
# The CTA target; carries ?smref=<leadId> so PostHog on the marketing site
# attributes the visit to the lead.
OUTREACH_LINK_BASE_URL=https://startmessaging.com
# CAN-SPAM requires a physical postal address in the footer of commercial
# mail. Rendered only when set — fill it in before real sends.
OUTREACH_POSTAL_ADDRESS=
# Hosts the click redirect will forward to; anything else falls back to the
# marketing site. This allowlist is what keeps /t/c from being an open redirect.

# Sentry
# Errors only — no tracing. Empty DSN = Sentry never initializes.
SENTRY_DSN=
# Force-off switch: set to false to disable without removing the DSN. Any
# other value (or empty) leaves Sentry governed by the DSN alone.
SENTRY_ENABLED=
# Defaults to NODE_ENV when unset.
SENTRY_ENVIRONMENT=
