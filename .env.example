PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=startmessaging
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Google OAuth (optional)
GOOGLE_CLIENT_ID=

# Fast2SMS
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=dlt
FAST2SMS_SENDER_ID=
FAST2SMS_DLT_TEMPLATE_ID=

# 2Factor.in
TWOFACTOR_API_KEY=
TWOFACTOR_TEMPLATE_NAME=OTP1

# OTP Settings
# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# OTP
OTP_EXPIRY_MINUTES=5
OTP_COST=0.25

# Redis
REDIS_URL=redis://localhost:6379

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_NAME=StartMessaging
MAILGUN_FROM_EMAIL=
  
# Custom Testing
MOCK_SMS_SEND=false

# PostHog Logging (OpenTelemetry)
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

