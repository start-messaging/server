# Isolated end-to-end test environment.
#
# Points at sm_test and its own Redis logical DB so a test run can truncate
# freely. sm_db is the development database — it holds real users, messages
# and leads — and must never be the target of a run that truncates.
#
# The logical DB is not on its own enough to isolate Redis — BullMQ has not
# always honoured the /N path in REDIS_URL — so REDIS_KEY_PREFIX below is the
# floor that keeps this suite's keys, queues included, off a dev API's.
#
# sm_test is shared by all three e2e suites (server API, admin panel,
# dashboard), so they cannot run concurrently — one at a time.
NODE_ENV=test
PORT=3010

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=sm_test
DATABASE_USERNAME=postgres
DATABASE_SYNCHRONIZE=false

REDIS_URL=redis://127.0.0.1:6379/14
# Namespaces every Redis key the suite writes, BullMQ's included — BullMQ takes
# REDIS_KEY_PREFIX as its own queue prefix. Without it this API sat on the bare
# `bull:*` keyspace shared with whatever dev API was running on the same
# machine, and the two sets of workers drained each other's queues: that is
# what the intermittent "webhook worker never moved message X to delivered"
# timeouts were. The panels have always carried one (uiadmin, uidash) and never
# saw the failure.
REDIS_KEY_PREFIX=e2e

JWT_SECRET=e2e-jwt-secret-not-a-real-key-0000000000
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

PARTNER_JWT_SECRET=e2e-partner-secret-not-a-real-key-1111
PARTNER_JWT_EXPIRATION=1h
AFFILIATE_REFERRAL_BASE_URL=http://localhost:5173

BCRYPT_ROUNDS=4
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
SMS_CONSOLE_PROVIDER=true
OTP_COST=0.25
DATABASE_PASSWORD=postgres
AFFILIATE_SCHEDULER_ENABLED=false
# The reconcile sweep settles messages no provider webhook ever arrived for,
# and configuration.ts switches it off only on an explicit `false` — an
# environment that has never heard of the flag registers it and runs it. Left
# on it wakes mid-run and rewrites message rows between a seed and the
# assertion against it. Both panels set it for this reason: see
# admin-panel/e2e/helpers/test-env.ts and dashboard/e2e/helpers/env.ts.
SMS_RECONCILE_ENABLED=false

# Dummy gateway credentials so the payment routes are exercisable. No network
# call is made: verification fails on the signature before any request.
RAZORPAY_KEY_ID=rzp_test_e2e0000000000
RAZORPAY_KEY_SECRET=e2e-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=e2e-razorpay-webhook-secret

# Leads & outreach test seams: ingest/enrich fetch a local fixture server the
# specs run on port 41100; outreach uses the console provider (no SMTP);
# tracking URLs point back at the API under test. Cap of 5 keeps the
# daily-cap spec cheap (resetDb truncates events, so each test starts at 0).
LEADS_NRD_URL_TEMPLATE=http://127.0.0.1:41100/nrd/{date}.txt
LEADS_ENRICH_URL_TEMPLATE=http://127.0.0.1:41100/site/{domain}
OUTREACH_CONSOLE_PROVIDER=true

# Browser-enrichment tier (headless Chromium), rendered against the same
# fixture server. The gate is on so the no_contact → browser escalation is a
# tested path. The EMPTY channel selects the playwright registry Chromium —
# present wherever `npx playwright install chromium` ran (this machine, and
# CI via its dedicated workflow step) — instead of a system Google Chrome the
# runner may not have.
LEADS_BROWSER_ENRICH_ENABLED=true
LEADS_BROWSER_CHANNEL=
OUTREACH_PUBLIC_BASE_URL=http://127.0.0.1:3010
OUTREACH_DAILY_CAP=5

# Google sign-in test seam. GOOGLE_MOCK_VERIFY makes AuthService accept
# `mock:<base64url JSON {sub, email, ...}>` id tokens instead of calling
# Google — double-locked in code on NODE_ENV=test, because an unsigned
# identity assertion honoured anywhere near production is account takeover.
# The client id is a dummy: it only has to exist for the route to get past
# its "not configured" refusal.
GOOGLE_CLIENT_ID=e2e-google-client-id.apps.googleusercontent.com
GOOGLE_MOCK_VERIFY=true

# R2 seam: the KYC specs run a local S3-compatible fixture server on port
# 41101 (the leads fixtures own 41100). R2_ENDPOINT points the S3 client at
# it (path-style), and the credentials are dummies the fixture never checks —
# the AWS SDK only needs a 200 back.
R2_ENDPOINT=http://127.0.0.1:41101
R2_ACCOUNT_ID=e2e-r2-account
R2_ACCESS_KEY_ID=e2e-r2-access-key-id
R2_SECRET_ACCESS_KEY=e2e-r2-secret-access-key
R2_BUCKET_NAME=e2e-kyc-bucket
R2_PUBLIC_URL=http://127.0.0.1:41101/public

# Fake payment gateway: order creation is answered locally so the create-order
# happy path is drivable; signature/webhook verification stays the real HMAC
# code against the dummy secrets above. Double-locked in code on NODE_ENV=test
# — a fake gateway reachable in production would mint top-ups for free.
PAYMENTS_FAKE_GATEWAY=true

# Deterministic SMS provider failure: a send addressed to exactly this number
# fails whichever provider is active, which is the only way to reach the
# provider-failure branch of /users/send-mobile-otp (its message embeds a
# random OTP, so the '000000' content seam cannot fire on purpose).
