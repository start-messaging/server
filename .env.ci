# Isolated end-to-end test environment.
#
# Points at its own database and its own Redis logical DB so a test run can
# truncate freely without touching sm_verify, which holds a restore of
# production data.
NODE_ENV=test
PORT=3010

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=sm_e2e
DATABASE_USERNAME=postgres
DATABASE_SYNCHRONIZE=false

REDIS_URL=redis://127.0.0.1:6379/14

JWT_SECRET=e2e-jwt-secret-not-a-real-key-0000000000
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

PARTNER_JWT_SECRET=e2e-partner-secret-not-a-real-key-1111
PARTNER_JWT_EXPIRATION=1h
AFFILIATE_REFERRAL_BASE_URL=http://localhost:5173

BCRYPT_ROUNDS=4
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
SMS_CONSOLE_PROVIDER=true
OTP_COST=0.25
DATABASE_PASSWORD=postgres
AFFILIATE_SCHEDULER_ENABLED=false

# Dummy gateway credentials so the payment routes are exercisable. No network
# call is made: verification fails on the signature before any request.
RAZORPAY_KEY_ID=rzp_test_e2e0000000000
RAZORPAY_KEY_SECRET=e2e-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=e2e-razorpay-webhook-secret
CONVENIENCE_FEE_ENABLED=false
